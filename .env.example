# Copy to .env. Never commit .env.

# The token for the canvas and API (required in Docker): openssl rand -hex 32
HUDDLE_TOKEN=

# How others reach this Huddle, for webhook and A2A addresses.
# HUDDLE_PUBLIC_URL=https://huddle.example.com

# A separate token for assistants and MCP clients that call Huddle over A2A or MCP (defaults to HUDDLE_TOKEN).
# HUDDLE_A2A_TOKEN=

# "Describe it": any OpenAI-compatible chat API.
# HUDDLE_LLM_URL=https://api.openai.com/v1
# HUDDLE_LLM_MODEL=gpt-5-mini
# HUDDLE_LLM_KEY=
# A local Ollama from inside Docker:
# HUDDLE_LLM_URL=http://host.docker.internal:11434/v1
# HUDDLE_LLM_MODEL=qwen3:8b

# Memory: how many characters of kept notes each request may carry (default 4000). Past that, the
# notes that match the request go first.
# HUDDLE_MEMORY_BUDGET=4000
# Optional: find notes by meaning too, with any OpenAI-compatible embeddings API.
# HUDDLE_EMBED_URL=https://api.openai.com/v1
# HUDDLE_EMBED_MODEL=text-embedding-3-small
# HUDDLE_EMBED_KEY=
# Optional: a rerank API (Voyage, Cohere, Jina) to order the notes found.
# HUDDLE_RERANK_URL=https://api.voyageai.com/v1
# HUDDLE_RERANK_MODEL=rerank-2.5-lite
# HUDDLE_RERANK_KEY=

# An NVIDIA OpenShell gateway, for assistants in sandboxes and their requests in Approvals.
# Mount the OpenShell CLI's client certificate folder (ca.crt, tls.crt, tls.key) at /certs.
# HUDDLE_OPENSHELL_GATEWAY=https://host.docker.internal:8080
# OPENSHELL_TLS_DIR=/certs

# Email through Resend (https://resend.com): the email connector, and mail that starts flows.
# A full-access key: sending only needs a sending key, but reading mail that arrives needs full access.
# RESEND_API_KEY=
# The signing secret (whsec_...) of Resend's email.received webhook, pointed at <HUDDLE_PUBLIC_URL>/hooks/email.
# RESEND_WEBHOOK_SECRET=
# Your own addresses, comma-separated: mail from them counts as you.
# HUDDLE_OWNER_EMAILS=you@example.com

# Your assistants' keys, under the names your flows give in "keyEnv".
# OPENCLAW_A2A_TOKEN=
# HERMES_A2A_TOKEN=
# SOCHEN_API_KEY=
# MONID_API_KEY=
# HASS_TOKEN=
