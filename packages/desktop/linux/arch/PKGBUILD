# Maintainer: N Divij
#
# huddle-bin on the AUR: the released .deb, unpacked as is (it bundles its own Node, so it needs no
# nodejs). After a release: set pkgver, run updpkgsums, then makepkg --printsrcinfo > .SRCINFO.
pkgname=huddle-bin
pkgver=0.2.0
pkgrel=1
pkgdesc='One place for all your AI assistants: put them on a canvas, share memory, approve what matters'
arch=('x86_64')
url='https://github.com/N-45div/huddle'
license=('AGPL-3.0-only')
depends=('gtk3' 'webkit2gtk-4.1' 'libayatana-appindicator' 'hicolor-icon-theme')
optdepends=('ollama: run models on this computer')
provides=('huddle')
conflicts=('huddle')
# The binaries come stripped; the bundled Node must stay byte for byte as released.
options=('!strip' '!debug')
source=("https://github.com/N-45div/huddle/releases/download/v${pkgver}/Huddle_${pkgver}_amd64.deb")
sha256sums=('SKIP')

package() {
  bsdtar -xf data.tar.* -C "${pkgdir}"
  chmod -R u=rwX,go=rX "${pkgdir}/usr"
}
