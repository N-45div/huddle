{
  "name": "huddle",
  "private": true,
  "type": "module",
  "description": "n8n for personal assistants: connect your AI assistants, give them one shared memory, and draw how they hand work to each other.",
  "license": "AGPL-3.0-only",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --no-warnings packages/server/src/main.ts",
    "build": "npm run build -w @huddle/web",
    "dev": "npm run dev -w @huddle/web",
    "huddle": "node --no-warnings packages/core/src/cli.ts",
    "example": "node --no-warnings packages/core/src/cli.ts run examples/invoices.json --input @examples/invoice.txt",
    "test": "node --no-warnings --test \"packages/core/test/*.test.ts\" \"packages/server/test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
